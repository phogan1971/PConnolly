# --- Database ----------------------------------------------------------------
# Local Postgres (use docker-compose.yml at the repo root)
DATABASE_URL="postgresql://dealerops:dealerops@localhost:5432/dealerops?schema=public"

# --- Auth --------------------------------------------------------------------
# 32+ random chars: openssl rand -base64 32
AUTH_SECRET="change-me-in-prod"
NEXTAUTH_URL="http://localhost:3000"

# --- Media storage -----------------------------------------------------------
# 'local' for dev, 's3' for prod
MEDIA_STORAGE_PROVIDER="local"
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# --- AI provider (optional, advert generator falls back to template) --------
AI_PROVIDER="none"   # 'none' | 'anthropic' | 'openai'
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# --- Email (optional in dev) -------------------------------------------------
EMAIL_PROVIDER="console"   # 'console' | 'resend'
RESEND_API_KEY=""
EMAIL_FROM="DealerOps <noreply@dealerops.local>"

# --- Carzone adapter ---------------------------------------------------------
# 'export' (default, manual feed file) | 'mock-api' (dev only) | 'api' (later, when official creds are issued)
CARZONE_ADAPTER="export"
CARZONE_FEED_TOKEN="rotate-me"   # protects /api/exports/carzone/feed.* when fetched externally

# --- Cron / jobs -------------------------------------------------------------
CRON_SECRET="rotate-me"
